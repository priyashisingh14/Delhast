# ==========================================
# SERVER ENVIRONMENT CONFIGURATION
# ==========================================

# Application Environment (development, production, test)
NODE_ENV=development

# Server Port
PORT=5000

# Client Application URL (for CORS & Cookie domain)
CLIENT_URL=http://localhost:5173

# MongoDB Connection URI
# Leave empty or set to mongodb://localhost:27017/college_portal
# If left empty in development, an embedded in-memory MongoDB will auto-boot for zero-friction testing
MONGODB_URI=

# JWT Secrets (Use strong random strings in production)
JWT_ACCESS_SECRET=super_secret_access_jwt_key_college_portal_2026_change_in_prod
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_college_portal_2026_change_in_prod
JWT_RESET_SECRET=super_secret_reset_jwt_key_college_portal_2026_change_in_prod

# Token Expiry Durations
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d
RESET_TOKEN_EXPIRY=15m

# ==========================================
# EMAIL SERVICE CONFIGURATION (DECOUPLED)
# ==========================================
# Options: 'gmail' or 'mock' (for development/tests)
EMAIL_PROVIDER=mock

# College Portal Sender Details
EMAIL_FROM_NAME="Apex Institute Portal"
EMAIL_FROM_ADDRESS=college.portal.auth@gmail.com

# SMTP Configuration (Used when EMAIL_PROVIDER=gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_college_portal@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password

# ==========================================
# OTP POLICY CONFIGURATION
# ==========================================
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ==========================================
# STUDENT REGISTRATION POLICY
# ==========================================
# Format regex for college registration numbers (e.g. 23CSE101, 22ECE045, etc.)
REGISTRATION_NUMBER_REGEX=^[0-9]{2}[A-Z]{3}[0-9]{3,4}$

# Whether to enforce validation against Master College Student Database
ENFORCE_MASTER_STUDENT_DB=true

# ==========================================
# OCR & FILE UPLOAD CONFIGURATION
# ==========================================
# OCR Engine: 'tesseract' (pure JS/WASM engine) or 'mock'
OCR_ENGINE=tesseract
MAX_UPLOAD_SIZE_MB=5
TEMP_UPLOAD_DIR=./uploads/temp
