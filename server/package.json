    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.12.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.0",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.3",
    "tesseract.js": "^6.0.0",
    "zod": "^3.24.2"
